{
  "name": "ban-fixed-width-prose",
  "version": "1.0.0",
  "description": "Detect and ban hard-wrapped prose in Markdown and text files",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ban-fixed-width-prose": "./bin/ban-fixed-width-prose.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "c8 --reporter=text --reporter=cobertura --check-coverage --lines=90 --branches=90 node --test",
    "check": "npm test && npm run coverage"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
