{
  "name": "ban-fixed-width-prose",
  "version": "1.0.0",
  "description": "Detect and ban hard-wrapped prose in Markdown and text files",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ban-fixed-width-prose": "./bin/ban-fixed-width-prose.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "c8 --reporter=text --reporter=cobertura --check-coverage --lines=90 --branches=90 node --test",
    "build": "ncc build src/action.js --minify -o dist",
    "check-action": "node scripts/validate-action.mjs",
    "check-bundle": "npm run build && git diff --exit-code -- dist/index.js",
    "check": "npm test && npm run coverage && npm run check-action && npm run check-bundle"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@vercel/ncc": "^0.38.3",
    "c8": "^12.0.0"
  }
}
