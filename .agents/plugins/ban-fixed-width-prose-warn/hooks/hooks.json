{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|file_edit|edit|write_file|write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/bin/hook.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
